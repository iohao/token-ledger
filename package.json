{
  "name": "tokenledger",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "package:app": "bash scripts/package-app.sh",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "clsx": "^2.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.0",
    "lucide-react": "^1.35.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.tokenledger.app",
    "productName": "TokenLedger",
    "directories": {
      "output": "release-app"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iohao",
        "repo": "token-ledger"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "plugins/**/*",
      "!.agents/**/*",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/docs/**",
      "!node_modules/better-sqlite3/test/**",
      "!node_modules/better-sqlite3/benchmark/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "files": [
        "!node_modules/better-sqlite3/prebuilds/linux*/**",
        "!node_modules/better-sqlite3/prebuilds/win32*/**",
        "!node_modules/better-sqlite3/prebuilds/linux*",
        "!node_modules/better-sqlite3/prebuilds/win32*"
      ],
      "icon": "icons/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "files": [
        "!node_modules/better-sqlite3/prebuilds/darwin*/**",
        "!node_modules/better-sqlite3/prebuilds/linux*/**",
        "!node_modules/better-sqlite3/prebuilds/darwin*",
        "!node_modules/better-sqlite3/prebuilds/linux*"
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
