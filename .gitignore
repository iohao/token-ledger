# Dependencies
.openwikiignore
node_modules/
.npm/
.pnpm-store/
.yarn/
yarn.lock.bak
bun.lockb

# Frontend build and tooling output
dist/
dist-ssr/
.vite/
.cache/
*.tsbuildinfo
.eslintcache

# Rust and Tauri build output
target/
src-tauri/target/
src-tauri/gen/
src-tauri/.cargo/
release-app/
*.app/
*.dmg
*.zip

# Local databases and runtime files
*.db
*.db-*
*.sqlite
*.sqlite-*

# Environment and local configuration
.env
.env.*
!.env.example
*.local

# IDE and editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
code-space-state/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
.fseventsd

# Local tools and agent caches
.antigravitycli/
.qoder/
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/skills/
.codebase-memory/
.agents/*
!.agents/skills/

# Local scratch and release state
local/
_local/
.release-state/
openwiki/

# Coverage and test output
coverage/
.nyc_output/
test-results/

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
*.tmp
*.temp
*.orig
*.rej
